# QwenProxy Configuration
#
# Os padrões já são otimizados para produção.
# Só descomente/altere o que você realmente precisa mudar.

# ============================================================
# Contas Qwen
# ============================================================
# Obrigatório se você não usar `npm run login` para salvar contas no banco.
# Use ';' para separar contas.
QWEN_ACCOUNTS=email1@example.com:password1;email2@example.com:password2

# ============================================================
# API / servidor
# ============================================================
# Protege o proxy com uma API key.
#API_KEY=

# Porta do servidor.
#PORT=3000

# ============================================================
# Browser / RAM
# ============================================================
# true: browser invisível, consome menos RAM.
# false: browser visível, útil para debug.
#PLAYWRIGHT_HEADLESS=true

# Mantém apenas N contextos de browser abertos.
# Contas acima desse limite ficam em standby e abrem sob demanda.
# Padrão: 1
#PLAYWRIGHT_MAX_ACTIVE_CONTEXTS=1

# false: prepara somente a primeira conta no startup.
# true: prepara todas as contas no startup.
# Padrão: false
#PLAYWRIGHT_PREPARE_ALL_ON_STARTUP=false

# ============================================================
# Timeouts
# ============================================================
# Os padrões já são seguros para a maioria dos casos.
# Só altere se você tiver um motivo específico.
#
# PAGE_TIMEOUT=60000
# NAVIGATION_TIMEOUT=60000
# TIME_TO_FIRST_BYTE=60000
# TOTAL_REQUEST_TIMEOUT=600000

# ============================================================
# Comportamentos opcionais
# ============================================================
# Apaga chats criados no Qwen ao desligar o servidor.
#DELETE_ALL_CHATS_ON_SHUTDOWN=false

# Limite de streams simultâneos por conta.
# Padrão: 1
#ACCOUNT_MAX_CONCURRENT_STREAMS=1
